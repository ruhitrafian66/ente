<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    package="io.ente.photos">

    <!-- Strips MainActivity's launcher entry, so that the app does not have
         several launcher entries: the activity-alias entries in the main
         manifest are the launcher icons. We can remove this along with the
         `LAUNCHER` category from main/AndroidManifest.xml once
         https://github.com/flutter/flutter/issues/38965 is fixed. -->
    <application>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER" tools:node="remove"/>
            </intent-filter>
        </activity>
    </application>

    <uses-permission android:name="com.android.vending.BILLING"  tools:node="remove"/>
    <!-- Offline fork: INTERNET comes from the main manifest (CLIP model
         download only). -->
</manifest>
